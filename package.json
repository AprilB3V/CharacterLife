{
  "name": "characterlife",
  "version": "0.6.0",
  "private": true,
  "description": "CharacterLife · 可信 AI 角色的心智内核：六语义认知层 + 宪法完整性层（V0.6）",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "demo": "node examples/three-day-demo.ts",
    "demo:persistent": "node examples/persistent-demo.ts",
    "qq:demo": "node examples/qq-bot/demo.ts",
    "qq:server": "node examples/qq-bot/server.ts",
    "onebot:demo": "node examples/onebot/demo.ts",
    "onebot:server": "node examples/onebot/server.ts",
    "st:demo": "node examples/sillytavern/demo.ts",
    "st:server": "node examples/sillytavern/start-server.ts",
    "world:dev": "node examples/world/dev-server.ts",
    "world:demo": "node examples/world/world-demo.ts",
    "world:intent": "node examples/world/intent-demo.ts",
    "st:probe": "node experiments/real-clients/sillytavern-smoke.ts",
    "ab": "node experiments/ab/run.ts",
    "continuity": "node experiments/persona-continuity/run.ts",
    "real:smoke": "node experiments/real-model/smoke.ts",
    "real:continuity": "node experiments/real-model/continuity.ts",
    "world:real": "node experiments/real-model/world-intent.ts",
    "sandbox": "node experiments/sandbox/run.ts",
    "sandbox:h5": "node experiments/sandbox/h5.ts",
    "test": "node --test --test-isolation=none \"tests/**/*.test.ts\"",
    "test:builtin": "node --test tests/",
    "typecheck": "tsc -p tsconfig.json",
    "onebot:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-onebot.ps1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.2"
  }
}

# CharacterLife 环境变量示例（复制为 .env 或直接注入 shell）
# 注意：本项目**只有 scripts/start-onebot.ps1 会加载这个文件**，其他入口（npm run qq:server、
#       npm run st:server、各种 demo）都不读 .env，需要你自己注入环境变量。
#       请不要把真实值提交到 Git。
# 所有密钥都只在运行时内存中使用。

# ── 通用 ────────────────────────────────────────────────────────────────
# SQLite 数据库路径
CHARACTERLIFE_DB=data/characterlife.db
# 世界 id（同一个角色模板在不同世界线里互不影响）
CHARACTERLIFE_WORLD=world_local

# ── 真实模型（可选；不填则自动使用 MockProvider）─────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 推理强度：default | disabled(off) | low | minimal。留空按模型取已验证默认值
# （doubao-seed-2-1 关闭、glm-5-3 low、其余不发送任何推理字段）
CHARACTERLIFE_REASONING=

# ── 本地 HTTP API（SillyTavern / 自建前端）────────────────────────────
# 必填，至少 8 位；客户端用它做 Bearer Token
CHARACTERLIFE_API_TOKEN=local-dev-token-change-me
CHARACTERLIFE_HOST=127.0.0.1
CHARACTERLIFE_PORT=8787
# 酒馆本地身份（单用户模式）
CHARACTERLIFE_ST_IDENTITY=local-default
# 非回环监听需要显式开启；公网部署不在本项目授权范围内
CHARACTERLIFE_ALLOW_PUBLIC=false

# ── QQ 官方机器人（Webhook 模式）──────────────────────────────────────
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_WEBHOOK_PORT=8788
QQBOT_WEBHOOK_PATH=/qq/webhook
# 是否声明支持主动消息（需要账号额度 + 用户未关闭开关；没有把握就保持 false）
QQBOT_PROACTIVE=false
# 仅本地调试用：跳过 Webhook 签名校验（生产环境绝对不要开）
QQBOT_SKIP_SIGNATURE=false

# ── OneBot 11 网关（NapCat / Lagrange.OneBot / SnowLuma）────────────────
# 只有配置了 ONEBOT_API_BASE 才会装配 OneBot 适配器
ONEBOT_API_BASE=http://127.0.0.1:3000
# 与网关 http server 的 access_token 一致
ONEBOT_ACCESS_TOKEN=
# 与网关 http post 的 secret 一致；不填会打警告并接受未签名上报
ONEBOT_SECRET=
# 本服务接收上报的地址（填到网关的「HTTP 上报」里）
ONEBOT_HOST=127.0.0.1
ONEBOT_PORT=8790
ONEBOT_PATH=/onebot/event
# 跨机部署才需要开启
ONEBOT_ALLOW_PUBLIC=false
# 群聊只在被 @ 时回应；设 false = 每条群消息都回（刷屏 + 风控）
ONEBOT_GROUP_MENTION_ONLY=true
# 群里的 /help 这类指令不需要 @
ONEBOT_ALLOW_GROUP_COMMANDS=true
# 落库前把 QQ 号哈希成假名（隐私）；设 false 则直接存 QQ 号
ONEBOT_ANONYMIZE=true
# 是否采集昵称/群名片（默认不采集）
ONEBOT_CAPTURE_NICKNAME=false
# 机器人自己的 QQ 号（事件缺 self_id 时用于判断「被 @」）
ONEBOT_SELF_ID=
# 是否声明主动消息能力（OneBot 网关能发就能发，默认 true）
ONEBOT_PROACTIVE=true
# 回复前等待期（毫秒，可写范围），期间补充的消息并进同一轮；0 关闭
ONEBOT_REPLY_WAIT_MS=3000-5000
# 回复按行拆成多条发送，并去掉每条句尾的句号
ONEBOT_SPLIT_REPLIES=true
# 学习对方的说话方式和发送节奏，作为资料给回复模型
ONEBOT_CONVERSATION_STYLE=true

# ── Telegram 机器人（Bot API 长轮询，仅私聊）────────────────────────────
# 只有配置了 TELEGRAM_BOT_TOKEN 才会装配 Telegram 适配器；token 找 @BotFather 申请，只放环境变量
TELEGRAM_BOT_TOKEN=
# 允许对话的 Telegram 用户 id（数字，逗号分隔）。白名单外的人发消息会被忽略，
# 启动后先给机器人发一条消息，日志里会打印你的 id
TELEGRAM_ALLOWED_USER_IDS=
# 设 true 则任何人都能和机器人聊（每条消息都花模型费用，慎用）
TELEGRAM_ALLOW_ANYONE=false
# 国内网络访问不了 api.telegram.org 时：填自建反代地址，或给 Node 设代理
# （NODE_USE_ENV_PROXY=1 + HTTPS_PROXY=http://127.0.0.1:7890）
TELEGRAM_API_BASE=
# 落库前把 Telegram 用户 id 哈希成假名；设 false 则直接存 id
TELEGRAM_ANONYMIZE=true
# 是否采集名字（默认不采集）
TELEGRAM_CAPTURE_NAME=false
# 用户按过 Start 后机器人可以主动发消息；设 false 则主动消息留在队列里
TELEGRAM_PROACTIVE=true
# 回复按空行拆成多条气泡（最多 3 条）
TELEGRAM_SPLIT_PARAGRAPHS=true


# ── 主人后台（思维链 / 配置 / 记忆审核）──────────────────────────────
# 设置后，OneBot / Telegram / SillyTavern 入口会在同一进程里启动后台（只监听 127.0.0.1）。
# 令牌至少 16 位，只放环境变量；思维链只存在进程内存里，重启清空
CHARACTERLIFE_CONSOLE_TOKEN=
CHARACTERLIFE_CONSOLE_PORT=8788


# ── 可选：真实 SillyTavern 联调探针 ───────────────────────────────────
SILLYTAVERN_DIR=C:\Git\SillyTavern-1.17.0

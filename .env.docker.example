# Copy to .env next to compose.yaml. Never commit the real .env.

# Required: Bearer token clients (SillyTavern) use to call the API, at least 8 characters.
CHARACTERLIFE_API_TOKEN=change-me-please

# Model. Leave all three empty to run on the offline mock model.
#
# Ollama on this machine (outside Docker). Ollama ignores the key, but a remote-looking
# address needs one, so any value works:
#   CHARACTERLIFE_MODEL_BASE_URL=http://host.docker.internal:11434/v1
#   CHARACTERLIFE_MODEL_MODEL=qwen3:8b
#   CHARACTERLIFE_MODEL_API_KEY=ollama
#
# Ollama container (docker compose --profile ollama up -d), same idea:
#   CHARACTERLIFE_MODEL_BASE_URL=http://ollama:11434/v1
#
# Hosted endpoint (DeepSeek, OpenAI, OpenRouter, ...), see docs/MODELS.md:
#   CHARACTERLIFE_MODEL_BASE_URL=https://api.deepseek.com
#   CHARACTERLIFE_MODEL_MODEL=deepseek-chat
#   CHARACTERLIFE_MODEL_API_KEY=sk-...
CHARACTERLIFE_MODEL_BASE_URL=
CHARACTERLIFE_MODEL_MODEL=
CHARACTERLIFE_MODEL_API_KEY=

# Optional: also run a Telegram bot in the same container (private chats only).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=

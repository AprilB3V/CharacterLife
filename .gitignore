# 依赖与构建产物
node_modules/
.npm-cache/
dist/
*.tsbuildinfo

# 运行时数据（演示/测试生成，不入库）
.data/
examples/.data/
tests/.data/
data/
reports/raw/
*.tmp

# 真实 SillyTavern 联调探针产生的数据（几十 MB，不入库）
.st-data/
st-startup.log

# 本地密钥与隐私（仓库中永不出现真实 Key）
.env
.env.*
!.env.example
*.local.json

# Security baseline: generated output may contain credentials or conversations.
*.log
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.jsonl
reports/*.json
backups/
*.bundle
*.patch
*.key
*.pem
*.p12
*.pfx
secrets/

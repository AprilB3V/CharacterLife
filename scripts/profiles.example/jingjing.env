# Copy to data/profiles/jingjing.env and adjust paths. CTL_* lines are read by scripts/cl.ts only.
CTL_LOG=data/onebot-jingjing.log
CTL_SNOWLUMA_CONFIG=C:\path\to\SnowLuma\config\onebot_<qq>.json
CTL_SNOWLUMA_CLIENT=characterlife
CTL_API_KEY_FROM=ARK_CODING_API_KEY
CTL_CONSOLE_TOKEN_FILE=data/console-token.txt

ONEBOT_API_BASE=http://127.0.0.1:3000
ONEBOT_SELF_ID=<bot qq>
ONEBOT_GROUP_MENTION_ONLY=true
ONEBOT_ALLOW_GROUP_COMMANDS=false
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
DEEPSEEK_MODEL=deepseek-v4-1-flash
CHARACTERLIFE_DB=data/onebot-jingjing.db
CHARACTERLIFE_WORLD=world_onebot_jingjing
CHARACTERLIFE_CHARACTER_MODULE=C:\path\to\character\jingjing-qq.ts
CHARACTERLIFE_CONSOLE_PORT=8788
